<?xml version="1.0" encoding="UTF-8"?>
<project name="TARUMT-ClinicManagementSystem" default="default" basedir=".">
    <description>TARUMT Clinic Management System - Assignment Project</description>
    
    <!-- Project Properties -->
    <property name="src.dir" value="."/>
    <property name="build.dir" value="build"/>
    <property name="dist.dir" value="dist"/>
    <property name="main.class" value="main.ClinicManagementSystem"/>
    
    <!-- Java Compilation Properties -->
    <property name="javac.source" value="20"/>
    <property name="javac.target" value="20"/>
    <property name="javac.compilerargs" value="-Xlint:all"/>
    <property name="javac.processorpath" value="${javac.classpath}"/>
    
    <!-- Initialize build directories -->
    <target name="init">
        <mkdir dir="${build.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>
    
    <!-- Clean build artifacts -->
    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
        <delete>
            <fileset dir="." includes="**/*.class"/>
        </delete>
    </target>
    
    <!-- Compile Java sources -->
    <target name="compile" depends="init">
        <javac srcdir="${src.dir}" 
               destdir="${build.dir}"
               source="${javac.source}"
               target="${javac.target}"
               includeantruntime="false"
               debug="true">
            <compilerarg line="${javac.compilerargs}"/>
            <include name="**/*.java"/>
        </javac>
        
        <!-- Copy data files to build directory -->
        <copy todir="${build.dir}">
            <fileset dir="${src.dir}">
                <include name="data/**/*.txt"/>
            </fileset>
        </copy>
    </target>
    
    <!-- Create JAR file -->
    <target name="jar" depends="compile">
        <jar destfile="${dist.dir}/TARUMT-ClinicManagementSystem.jar" 
             basedir="${build.dir}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
                <attribute name="Implementation-Title" value="TARUMT Clinic Management System"/>
                <attribute name="Implementation-Version" value="1.0"/>
                <attribute name="Implementation-Vendor" value="TARUMT Student"/>
                <attribute name="Built-By" value="${user.name}"/>
                <attribute name="Built-Date" value="${TODAY}"/>
            </manifest>
        </jar>
    </target>
    
    <!-- Run the application -->
    <target name="run" depends="compile">
        <java classname="${main.class}" 
              classpath="${build.dir}"
              fork="true">
            <jvmarg value="-Dfile.encoding=UTF-8"/>
        </java>
    </target>
    
    <!-- Run with debugging -->
    <target name="debug" depends="compile">
        <java classname="${main.class}" 
              classpath="${build.dir}"
              fork="true">
            <jvmarg value="-Xdebug"/>
            <jvmarg value="-Xrunjdwp:transport=dt_socket,server=y,suspend=y,address=8000"/>
            <jvmarg value="-Dfile.encoding=UTF-8"/>
        </java>
    </target>
    
    <!-- Test compilation (compile only, no run) -->
    <target name="test-compile" depends="compile">
        <echo message="Compilation successful! All Java files compiled without errors."/>
    </target>
    
    <!-- Default target -->
    <target name="default" depends="jar">
        <echo message="TARUMT Clinic Management System built successfully!"/>
        <echo message="Run with: java -jar dist/TARUMT-ClinicManagementSystem.jar"/>
        <echo message="Or use: ant run"/>
    </target>
    
    <!-- Development target for quick testing -->
    <target name="dev" depends="clean,compile,run"/>
    
</project>
